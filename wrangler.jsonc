{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "friendhub",
  "main": "./worker-preview-wrapper.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "XOXO_ACTIVITY_EMAILS_ENABLED": "true"
  },
  "previews": {
    "vars": {
      "XOXO_ACTIVITY_EMAILS_ENABLED": "false"
    }
  }
}
